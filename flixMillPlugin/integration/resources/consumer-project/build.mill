//| mvnDeps:
//| - io.github.wstein::flix-mill-plugin::0.0.0-PLACEHOLDER

package build

import mill.*
import mill.javalib.JavaModule
import flixmill.{FlixJointModule, FlixModule}

object app extends FlixModule

/** A JVM module consuming the Flix module's compiled output.
  *
  * A `FlixModule` is not a `JavaModule`, so it cannot go in `moduleDeps`; `flixClasspath` is the
  * seam instead. Nothing here is Flix-aware beyond that one line.
  */
object javaConsumer extends JavaModule {
  def unmanagedClasspath = Task { app.flixClasspath() }
  def mainClass = Some("com.example.App")
}

/** Java and Flix referencing each other inside one module.
  *
  * `javaConsumer` above is the one-way case: Java depends on Flix and nothing depends back. This
  * one has no valid build order without generated stubs -- `Helper` calls the Flix facade and the
  * Flix module calls `Helper`.
  */
object joint extends FlixJointModule {
  def mainClass = Some("com.example.App")
}

/** Exercises a project whose Flix sources live below the Mill module directory. */
object nested extends FlixModule {
  override def flixWorkingDirectory = moduleDir / "flix"
}
