package build

import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*
import mill.scalalib.scalafmt.*

object flixMillPlugin extends ScalaModule, SonatypeCentralPublishModule, ScalafmtModule {
  /** The oldest Mill 1.x version supported by the published plugin artifact. */
  def millVersion = "1.0.6"

  def scalaVersion = "3.7.4"
  def jvmVersion = "21"
  def scalacOptions = Seq("-Werror", "-Wunused:all")

  // Mill 1.x plugins are backwards compatible, but not forwards compatible.
  def platformSuffix = "_mill1"

  def mvnDeps = Seq(mvn"com.lihaoyi::mill-libs:$millVersion")

  def artifactName = "flix-mill-plugin"
  def publishVersion = "0.1.0"
  def pomSettings = PomSettings(
    description = "Flix compiler support for Mill",
    organization = "io.github.wstein",
    url = "https://github.com/wstein/flix-mill-plugin",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("wstein", "flix-mill-plugin"),
    developers = Seq(Developer("wstein", "Werner Stein", "https://github.com/wstein"))
  )

  // Upload the bundle but leave the release for a human to confirm in the Central
  // portal. Maven Central publications are immutable, so the last look at what is
  // about to become permanent is worth more than the click it costs.
  def sonatypeCentralShouldRelease = Task { false }

  object test extends ScalaTests, TestModule.Utest {
    def mvnDeps = Seq(mvn"com.lihaoyi::mill-testkit:$millVersion")
  }

  object integration extends ScalaTests, TestModule.Utest {
    def mvnDeps = Seq(mvn"com.lihaoyi::mill-testkit:$millVersion")

    // `publishLocalTestRepo` publishes into a Mill-owned `Task.dest` repository that the Mill
    // subprocess resolves through `MILL_USER_TEST_REPO`, so the gate never writes to
    // `~/.ivy2/local` and can only resolve what this build just published.
    def forkEnv = Task {
      Map(
        "MILL_EXECUTABLE_PATH" -> millExecutable.assembly().path.toString,
        "MILL_USER_TEST_REPO" -> publishLocalTestRepo().path.toString,
        "MILL_PLUGIN_VERSION" -> publishVersion()
      )
    }

    object millExecutable extends JavaModule {
      def mvnDeps = Seq(mvn"com.lihaoyi:mill-runner-launcher_3:$millVersion")
      def mainClass = Some("mill.launcher.MillLauncherMain")
    }
  }
}

// CI-only tooling for the GitHub-Pages Maven mirror: checksums, the additive
// group maven-metadata.xml merge, and the landing page. Deliberately a separate,
// unpublished module -- `flixMillPlugin` above is what gets published, and
// publishing tooling has no business inside the artifact consumers resolve.
object publishTools extends ScalaModule, ScalafmtModule {
  def scalaVersion = flixMillPlugin.scalaVersion
  def jvmVersion = flixMillPlugin.jvmVersion
  def scalacOptions = Seq("-Werror", "-Wunused:all")
  def mainClass = Some("flixmill.publishtools.Main")

  object test extends ScalaTests, TestModule.Utest {
    // `TestModule.Utest.utestVersion` defaults to empty (bring-your-own-dependency); the existing
    // `flixMillPlugin.test`/`integration` modules get it transitively through `mill-testkit`,
    // which this module has no other reason to depend on.
    def utestVersion = "0.9.1"
  }
}
